# Copy this file to .env on the app server and fill in real values.
# Never commit the actual .env file to GitHub.

# --- App ---
PORT=3000
NODE_ENV=production

# --- Database (matches the MySQL GRANT you set up on the DB server) ---
DB_HOST=DB_SERVER_PRIVATE_IP
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Password@1234
DB_NAME=sadhixapp_db

# --- CORS (comma separated origins allowed to call this API, * for all) ---
CORS_ORIGIN=*

# --- Auth (used to sign login tokens - change this to a long random string) ---
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
